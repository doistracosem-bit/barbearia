# Backend
PORT=3001
# Segredo do dono (NÃO commitar; aba do dono usa Authorization: Bearer <OWNER_TOKEN>)
OWNER_TOKEN=
# Origem(ns) permitidas por CORS, separadas por vírgula. "*" libera tudo (dev).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Proteção do agendamento público
BOOKING_MAX_PER_IP=5
BOOKING_WINDOW_MIN=15
MAX_ACTIVE_PER_PHONE=2
# 1 só atrás de proxy/CDN que define X-Forwarded-For (senão o IP pode ser forjado)
TRUST_PROXY=0
# Persistência (SQLite)
DATA_DIR=server/data
DB_PATH=

# Frontend
VITE_API_URL=http://localhost:3001
